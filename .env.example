# ========================================================
# SurveyLab Root Environment Configuration Reference
# ========================================================
# Each service maintains its own .env file in its respective directory.
# This file serves as a reference template for all services.

# --- Backend Node (backend-node/.env) ---
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
PYTHON_SERVICE_URL=http://localhost:8000
PYTHON_TIMEOUT_MS=5000

# --- Backend Python (backend-python/.env) ---
PYTHON_HOST=0.0.0.0
PYTHON_PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5173

# --- Frontend (frontend/.env) ---
VITE_NODE_API_URL=http://localhost:5000/api
VITE_PORT=3000
